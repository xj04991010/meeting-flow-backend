SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NODE_ENV=development
PORT=3000

# Dashboard URL used in Telegram buttons.
DASHBOARD_BASE_URL=http://localhost:5173

# Optional. Set this in production to allow the dashboard to open in a normal browser.
# Use a long random value and keep it private.
DASHBOARD_ACCESS_TOKEN=

# Optional comma-separated origins. Local private-network origins are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
